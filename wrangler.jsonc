{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "email-game",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "inboxed.fun",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "GAME_STATE_KV",
      "id": "659e2e65e8bb4081a402110fda15b339"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inboxed-db",
      "database_id": "2fbc6baa-df3d-44ac-a8fd-78877e46416b"
    }
  ],
  "assets": {
    "directory": "./public"
  },
  "triggers": {
    "crons": [
      "0 15 * * *"
    ]
  },
  "vars": {
    "PUBLIC_HTTPS_URL": "https://inboxed.fun",
    "SENDER_EMAIL": "Inboxed <game@inboxed.fun>",
    "MAILGUN_DOMAIN": "inboxed.fun",
    "TEST_EMAILS": "ekim0252@gmail.com",
    "SEND_CRON": "0 15 * * *"
  }
}